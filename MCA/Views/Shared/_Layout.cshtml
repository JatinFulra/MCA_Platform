<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MCA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MCA.styles.css" asp-append-version="true" />
</head>
<body>


        <div class="container-fluid">
            <div class="row">

                <!-- Sidebar (Fixed Left) -->
                <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar">
                    <ul class="nav flex-column p-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contract" asp-action="Index">Contracts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Merchant" asp-action="Index">Merchants</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Email">Syndicates</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">ISO</a>
                        </li>
                    </ul>
                </nav>

                <!-- Right Main Content -->
                <main class="col-md-9 col-lg-10 px-4 mt-3">
                    @RenderBody()
                </main>

            </div>
        </div>


   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
